{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codenotch Gemini Web",
  "version": "1.23.0-gemini.1",
  "identifier": "com.codenotch.geminiweb",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 340,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "title": "Codenotch Gemini Web"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Codenotch Gemini Web contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Codenotch Gemini Web"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false
    },
    "useLocalToolsDir": true,
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "REPLACE_WITH_TAURI_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "codenotch-gemini-web"
}
